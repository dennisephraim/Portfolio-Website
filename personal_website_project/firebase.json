{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "rewrites": [
        { "source": "ephraimdennis.com/profile", "function": "sessionApp" },
        { "source": "ephraimdennis.com/sessionCreation", "function": "sessionApp" }
      ]      
    }
  ]
}
